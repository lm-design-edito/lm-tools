{
  "name": "@design-edito/tools",
  "version": "0.5.3",
  "description": "",
  "type": "module",
  "author": "Maxime Fabas",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/lm-design-edito/lm-tools"
  },
  "scripts": {
    "lint": "eslint",
    "lint:src": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.{js,jsx,ts,tsx}\"",
    "check:scripts": "npx tsc --project scripts/tsconfig.json --noEmit",
    "check:src:agnostic": "npx tsc --project src/agnostic/tsconfig.json --noEmit",
    "check:src:components": "npx tsc --project src/components/tsconfig.json --noEmit",
    "check:src:node": "npx tsc --project src/node/tsconfig.json --noEmit",
    "check:src": "npm run check:src:agnostic && npm run check:src:components && npm run check:src:node",
    "check": "npm run check:scripts && npm run check:src",
    "tests:node": "vitest run src/node --reporter verbose",
    "tests:agnostic": "vitest run src/agnostic --reporter verbose",
    "tests:react": "RENDERER=react vitest run --config vitest.components.config.ts --reporter verbose",
    "tests:preact": "RENDERER=preact vitest run --config vitest.components.config.ts --reporter verbose",
    "tests:components": "echo '[WIP] COMPONENTS TESTS ARE DISABLED FOR NOW' # npm run tests:react && npm run tests:preact",
    "tests": "npm run tests:node && npm run tests:agnostic && npm run tests:components",
    "demo:preact": "cd demo && npm run start:preact",
    "demo:react": "cd demo && npm run start:react",
    "demo": "cd demo && npm start",
    "build:scripts": "rm -rf .temp/scripts && mkdir -p .temp/scripts && npx esbuild scripts/**/*.ts --outdir=.temp/scripts --bundle --platform=node --format=esm --packages=external",
    "build:src": "rm -rf lib && mkdir -p lib && node .temp/scripts/build/index.js",
    "build": "npm run check && npm run tests && npm run lint:src && npm run build:scripts && npm run build:src",
    "build:quick": "npm run build:scripts && npm run build:src",
    "prepublishOnly": "npm run build && node .temp/scripts/pre-publish/index.js",
    "start:preact": "npm run demo:preact",
    "start:react": "npm run demo:react",
    "start": "npm run start:preact"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/prompts": "^2.4.9",
    "@types/quantize": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/semver": "^7.8.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "change-case": "^5.4.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-love": "^154.1.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prompts": "^2.4.2",
    "puppeteer": "^25.9.0",
    "semver": "^7.8.5",
    "simple-git": "^3.33.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/lib-storage": "^3.1117.0",
    "@google-cloud/storage": "^8.0.1",
    "@inquirer/prompts": "^8.6.0",
    "ansi-regex": "^6.3.0",
    "basic-ftp": "^6.2.0",
    "chalk": "^6.0.0",
    "express": "^5.2.1",
    "multer": "^2.0.0",
    "preact-render-to-string": "^6.7.0",
    "quantize": "^1.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
